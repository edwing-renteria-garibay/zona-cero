{
  "name": "zona-cero",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "FireWeapon": {
          "$className": "RemoteEvent"
        },
        "MatchState": {
          "$className": "RemoteEvent"
        },
        "ReloadWeapon": {
          "$className": "RemoteEvent"
        },
        "ShotFired": {
          "$className": "RemoteEvent"
        },
        "FireTurret": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterPack": {
      "AssaultRifle": {
        "$className": "Tool",
        "$properties": {
          "ToolTip": "Rifle de asalto",
          "CanBeDropped": false
        },
        "Handle": {
          "$className": "Part",
          "$properties": {
            "Size": [0.4, 0.8, 3],
            "Color": [0.2, 0.2, 0.2],
            "CanCollide": false,
            "Massless": true
          }
        }
      }
    }
  }
}
